[Unit]
Description=Caddy: TLS in front of the engine and relayer
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=50

[Service]
User=caddy
Group=caddy
ExecStart=/usr/local/bin/caddy run --environ --config /etc/caddy/Caddyfile
# The admin API is a socket in /run/caddy (the Caddyfile's `admin`), not localhost:2019.
ExecReload=/usr/local/bin/caddy reload --config /etc/caddy/Caddyfile --address unix//run/caddy/admin.sock --force
RuntimeDirectory=caddy
Environment=XDG_DATA_HOME=/var/lib/caddy XDG_CONFIG_HOME=/var/lib/caddy
# SKECH_DOMAIN, the name the Caddyfile serves: written by setup.sh.
EnvironmentFile=/etc/caddy/env
Restart=on-failure
LimitNOFILE=65536
MemoryMax=200M

# Ports 80 and 443, and nothing else it would need root for. It writes only its certificates.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/caddy
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
