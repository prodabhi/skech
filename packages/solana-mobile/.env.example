# The Privy app (dashboard.privy.io): the embedded Solana wallet, signed in by email or text. Both are public.
EXPO_PUBLIC_PRIVY_APP_ID=cmuzqwmig01200dl8gf8j8tf2
# Its app client for the phone (App settings > Clients, allowed identifier trade.skech.app). Empty: no sign-in.
# Never the app secret: that is the server's, and anything here ships inside the app.
EXPO_PUBLIC_PRIVY_CLIENT_ID=
# Where the app reaches the engine (prices) and the Solana relayer. The box:
#   wss://api.skech.trade/engine/ws   and   wss://api.skech.trade/solana/ws
# On a simulator, the Mac's own: ws://localhost:3102/ws and ws://localhost:3104/ws
# (on the Android emulator, 10.0.2.2 instead of localhost).
EXPO_PUBLIC_ENGINE_URL=wss://api.skech.trade/engine/ws
EXPO_PUBLIC_RELAYER_URL=wss://api.skech.trade/solana/ws
# The community (profiles, the leaderboard, who is playing, everyone's ink): beside the relayer, at
# https://api.skech.trade/social, unless this says otherwise. A laptop's service, through a tunnel (https: a release
# build allows nothing in the clear): cloudflared tunnel --url http://localhost:3105, and its https address here.
EXPO_PUBLIC_SOCIAL_URL=
